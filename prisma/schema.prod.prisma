// AgentForge — PRODUCTION schema (Postgres on Vercel/Supabase)
// Used by Vercel build via: bunx prisma generate --schema=prisma/schema.prod.prisma
// And: bunx prisma db push --schema=prisma/schema.prod.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  password       String
  anonymizedId   String    @unique @default(cuid())
  telemetryOptIn Boolean   @default(true)
  tosAcceptedAt  DateTime?
  tosVersion     String?
  lastActiveAt   DateTime? @default(now())
  deactivatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  apiKeys       ApiKey[]
  integrations  Integration[]
  dailyLogs     DailyLog[]
  conversations Conversation[]

  @@index([lastActiveAt])
  @@index([deactivatedAt])
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  service   String
  keyValue  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, service])
}

model Integration {
  id        String   @id @default(cuid())
  userId    String
  service   String
  enabled   Boolean  @default(false)
  config    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, service])
}

model DailyLog {
  id        String   @id @default(cuid())
  userId    String
  date      String
  content   String   @default("")
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model WaitlistEntry {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  position    Int       @default(0)
  status      String    @default("waiting") // waiting | offered | accepted | expired | removed
  notifiedAt  DateTime?
  offerExpiresAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, position])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  toolName  String?
  toolArgs  String?
  toolResult String?
  toolCalls String?
  model     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
